.DS_Store
.idea/
node_modules/

# personal memory: the repository versions only the *.template.md files, and
# the tools create the real files on first use — so what you clone never shows
# up as a change to send upstream
learnings.md
patterns.md
# argumentario.md: a retired file (see the product-scope issue), kept under its
# historical name so a pre-existing local copy stays ignored — never re-created
argumentario.md

# sessions are personal and don't go into the repository
sessions/*
!sessions/.gitkeep
# the example designs shipped with the repository (see README "Examples")
!sessions/2026-08-19-heimdall-fleet-health-measurement
!sessions/2026-08-19-heimdall-fleet-health-measurement-pt
!sessions/2026-08-19-bifrost-agent-driven-repo-fixes
!sessions/2026-08-19-bifrost-agent-driven-repo-fixes-pt
!sessions/2026-08-19-magic-deploy-secure-publishing
!sessions/2026-08-19-magic-deploy-secure-publishing-pt

# personal configuration (bucket, distribution, AWS profile) — the repository
# versions only .env.example
.env

# local machine state
.claude/settings.local.json
eval-report-*.md
*.lock
*.tmp
