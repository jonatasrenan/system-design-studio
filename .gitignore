.DS_Store
.idea/
node_modules/

# personal memory: the repository versions only the *.template.md files, and
# the tools create the real files on first use — so what you clone never shows
# up as a change to send upstream
learnings.md
padroes.md
argumentario.md

# sessions are personal and don't go into the repository
sessions/*
!sessions/.gitkeep

# personal configuration (bucket, distribution, AWS profile) — the repository
# versions only .env.example
.env

# local machine state
.claude/settings.local.json
eval-report-*.md
*.lock
*.tmp
