.DS_Store
.idea/
node_modules/

# memória pessoal: o repositório versiona só os *.template.md, e as ferramentas
# criam os arquivos reais no primeiro uso — assim o conteúdo de quem clona nunca
# aparece como mudança para fazer upstream
learnings.md
argumentario.md

# sessões são pessoais e não vão para o repositório
sessions/*
!sessions/.gitkeep

# configuração pessoal (bucket, distribution, perfil AWS) — o repositório versiona
# só o .env.example
.env

# estado local de máquina
.claude/settings.local.json
eval-report-*.md
*.lock
*.tmp
