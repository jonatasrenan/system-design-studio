# Personal configuration — copy to `.env` (which stays out of version control).
# A variable exported in the shell always wins over what's set here.

# Design sharing (tools/share.mjs). Without the first two, the command fails
# saying what's missing and never calls AWS.
SD_SHARE_BUCKET=my-bucket
SD_SHARE_BASE=https://example.com
# Optional: CloudFront distribution to invalidate after publishing.
SD_SHARE_DIST=
# Optional: AWS CLI credentials. Leave COMMENTED OUT to inherit the environment —
# an empty line here would export a profile with an empty name.
# AWS_PROFILE=my-profile
AWS_REGION=us-east-1

# Viewer
PORT=4400
