# Configuração pessoal — copie para `.env` (que fica fora do versionamento).
# O ambiente exportado no shell sempre vence o que estiver aqui.

# Compartilhamento de design (tools/share.mjs). Sem as duas primeiras, o comando
# falha dizendo o que falta e não chama a AWS.
SD_SHARE_BUCKET=meu-bucket
SD_SHARE_BASE=https://exemplo.com
# Opcional: distribution CloudFront a invalidar depois de publicar.
SD_SHARE_DIST=
# Opcional: credenciais da AWS CLI. Deixe COMENTADO para herdar o ambiente —
# a linha vazia exportaria um perfil de nome vazio.
# AWS_PROFILE=meu-perfil
AWS_REGION=us-east-1

# Viewer
PORT=4400
